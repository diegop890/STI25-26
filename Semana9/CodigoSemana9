void app_main(void)
{
    //Cremaos partición para la pila TCP/IP
    esp_err_t nvs_flash_init();

    // 1) Initialize the TCP/IP stack and the event loop
    esp_netif_init();
    esp_event_loop_create_default();

    esp_netif_create_default_wifi_sta();

    wifi_init_config_t configWifi1 = WIFI_INIT_CONFIG_DEFAULT();
    esp_wifi_init(&configWifi1);

    esp_wifi_set_mode(WIFI_MODE_STA);
    esp_wifi_start();
    wifi_config_t configWifi2 = {
        .sta = {
            .ssid = "grupo1",
            .password = "12345678"
        }
    };

    esp_wifi_set_config(WIFI_IF_STA, &configWifi2);
    esp_wifi_connect();
}

